{
  "name": "hire-general-webapp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/dev-banner.mjs && next dev",
    "build": "node scripts/build-with-banner.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:authenticated": "node scripts/run-authenticated-e2e.mjs",
    "test:load": "tsx scripts/load-test.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:migrations": "node scripts/validate-migrations.mjs",
    "test:migrations:integration": "node scripts/test-migrations-integration.mjs",
    "test:schema-bundle": "node scripts/build-test-schema-bundle.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "db:backup:encrypted": "bash scripts/backup-supabase-public.sh",
    "db:restore:test": "bash scripts/restore-supabase-public.sh",
    "storage:restore:test": "bash scripts/restore-supabase-storage.sh",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:migrations && npm run test:schema-bundle && npm run build",
    "prepare": "husky",
    "seed:locations": "tsx scripts/seed-locations-geonames.ts",
    "seed:schools": "tsx scripts/seed-schools-scorecard.ts",
    "seed:bls-salaries": "tsx scripts/seed-bls-oews.ts",
    "discover:kforce-leads": "node scripts/discover-kforce-leads.mjs",
    "analyze": "next experimental-analyze",
    "build:analyze": "npm run build && next experimental-analyze"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
